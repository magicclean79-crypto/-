[Unit]
Description=ACOS Web (production)
After=network-online.target acos-api.service
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/acos-current/apps/web
Environment=NODE_OPTIONS=--max-old-space-size=512
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PORT=3000
Environment=HOSTNAME=0.0.0.0
ExecStart=/usr/bin/npx next start --port 3000 --hostname 0.0.0.0
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/ec2-user/acos-data/web.log
StandardError=append:/home/ec2-user/acos-data/web.err.log

[Install]
WantedBy=multi-user.target
