# ── Database (PostgreSQL) ──────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/acos?schema=public"

# ── Redis ──────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── MinIO (S3-compatible object storage) ───────────────
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="acos"
# 브라우저에서 접근하는 공개 URL이 S3_ENDPOINT와 다를 때만 설정
# S3_PUBLIC_URL="http://localhost:9000"

# ── API ────────────────────────────────────────────────
PORT=4000
WEB_URL="http://localhost:3000"

# ── OCR ────────────────────────────────────────────────
# Provider: mock(기본, 실제 OCR 없이 테스트 JSON 반환) | tesseract(로컬 오프라인 엔진)
# 향후: google-vision | azure-vision | aws-textract | clova (docs/architecture/ocr.md 참고)
OCR_PROVIDER="mock"
OCR_LANGS="eng+kor"
OCR_MAX_ATTEMPTS=3

# ── AI 분석 ─────────────────────────────────────────────
# Provider: mock(기본, 실제 AI 미연결) — 향후: claude | openai (docs/architecture/analysis.md)
ANALYSIS_PROVIDER="mock"
ANALYSIS_MAX_ATTEMPTS=3
