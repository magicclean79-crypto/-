# ── Database (PostgreSQL) ──────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/acos?schema=public"

# ── Redis ──────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── MinIO (S3-compatible object storage) ───────────────
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="acos"
# 브라우저에서 접근하는 공개 URL이 S3_ENDPOINT와 다를 때만 설정
# S3_PUBLIC_URL="http://localhost:9000"

# ── API ────────────────────────────────────────────────
PORT=4000
WEB_URL="http://localhost:3000"

# ── OCR ────────────────────────────────────────────────
# Provider: mock(기본, 실제 OCR 없이 테스트 JSON 반환) | tesseract(로컬 오프라인 엔진)
# 향후: google-vision | azure-vision | aws-textract | clova (docs/architecture/ocr.md 참고)
OCR_PROVIDER="mock"
OCR_LANGS="eng+kor"
OCR_MAX_ATTEMPTS=3

# ── AI 분석 ─────────────────────────────────────────────
# 공식 분석 엔진은 LLM 기반 (TASK-0504) — 모델 선택은 아래 LLM_PROVIDER 하나로 관리
# (구 ANALYSIS_PROVIDER 환경 변수는 제거됨, docs/architecture/analysis.md)
ANALYSIS_MAX_ATTEMPTS=3

# ── Vision ─────────────────────────────────────────────
# 공식 Vision 엔진은 LLM 기반 멀티모달 (TASK-0505) — 모델 선택은 LLM_PROVIDER 하나로 관리
# (구 VISION_PROVIDER 환경 변수는 제거됨, docs/architecture/vision.md)
VISION_MAX_ATTEMPTS=3
# 한 번의 분석에 첨부하는 최대 이미지 수 (CTO 결정: 환경변수로 조정 가능)
VISION_MAX_IMAGES=5
# Image Guard & Preprocessing (TASK-0604) — 검증·리사이즈·EXIF 제거·용량 제한
# VISION_IMAGE_MAX_SOURCE_BYTES=20971520   # 원본 최대 (기본 20MB)
# VISION_IMAGE_MAX_DIMENSION=1024          # 리사이즈 최대 변(px)
# VISION_IMAGE_MAX_OUTPUT_BYTES=5242880    # 전처리 후 최대 (기본 5MB)

# ── Content(상세페이지) ─────────────────────────────────
# 구 Generator 경로도 Wrapper를 통해 공식 Content Generation Engine을 호출 (TASK-0506)
# — 모델 선택은 LLM_PROVIDER 하나로 관리 (구 CONTENT_GENERATOR 환경 변수는 제거됨)

# ── LLM Gateway (TASK-0501) ────────────────────────────
# Provider: mock(기본, 실제 API 미호출) | openai(TASK-0603 공식 연결) | anthropic | gemini
# 실제 Provider는 해당 API 키가 있어야 활성화 — 없으면 mock으로 대체 (docs/architecture/llm.md)
# 연결 확인: GET /llm/health (실호출 기반 상태 점검)
LLM_PROVIDER="mock"
LLM_MAX_ATTEMPTS=3
# OpenAI — responseFormat(json_object)·멀티모달·Execution Cost(gpt-4o 단가) 활성화됨
# OPENAI_API_KEY=""
# LLM_OPENAI_MODEL="gpt-4o"
# ANTHROPIC_API_KEY=""
# LLM_ANTHROPIC_MODEL="claude-opus-5"
# GEMINI_API_KEY=""
# LLM_GEMINI_MODEL="gemini-2.5-flash"

# ── 이미지 생성/편집 (Sprint 36, T1-150) ─────────────────
# 배경 제거·배경 생성·제품 합성·Hero/사용장면/디테일 등 상세페이지 composition 생성.
# Provider: openai(GPT Image 2, T1-150부터 기본) | gemini | mock(기본, 키 없을 때)
# 미지정 시 OPENAI_API_KEY가 있으면 openai, 없고 GEMINI_API_KEY만 있으면 gemini로 자동 선택.
# IMAGE_GEN_PROVIDER="openai"
# OPENAI_IMAGE_MODEL="gpt-image-2"
# GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"

# ── 인증 (TASK-0801) ───────────────────────────────────
# 사용자 0명일 때 최초 기동 시 관리자 자동 생성 — 운영에서는 반드시 지정
# AUTH_ADMIN_EMAIL="admin@acos.local"
# AUTH_ADMIN_PASSWORD="admin1234"

# ── 백업 (TASK-1601) ───────────────────────────────────
# 운영 필수 — 미설정 시 기동 실패(CTO 결정 1601-①). 컨테이너/인스턴스 밖
# 볼륨을 가리켜야 한다(호스트가 사라지면 컨테이너 안 백업도 함께 사라진다).
# BACKUP_DIR="/var/backups/acos"
