# 검증 환경 설정 본보기 (TASK-4401, CTO 정책 4401-④)
#
# 이 파일에는 **비밀이 하나도 없습니다.** 채워야 하는 칸의 이름과 그 칸이
# 왜 필요한지만 적습니다 — 예시 값에 진짜처럼 보이는 키를 적어 두면 그것이
# 그대로 복사돼 들어가고, 나중에 "왜 이 키였지"에 답할 수 없게 됩니다.
#
# 확인: pnpm validation:preflight  (exit 0이어야 시작할 수 있습니다)
# 절차: docs/operations/production-activation-runbook.md

# ── 1. Provider 자격 증명 (사람이 줘야 함) ──────────────────────────────
# 실 호출 없이 재는 모든 숫자는 스텁의 숫자입니다.
# 넣기 전에 해당 모델의 단가가 승인·적용돼 있는지 확인하세요(정책 3101-①) —
# 가격표에 없는 모델은 비용이 null(미산정)로 남고 예산 계산에서 빠집니다.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── 2. Network Allowlist (사람이 줘야 함) ───────────────────────────────
# 이 환경의 프록시는 api.openai.com을 막고 있습니다(HTTP 403).
# 키가 틀린 것과 길이 막힌 것은 다른 문제이고, 길이 막혀 있으면 올바른 키를
# 넣어도 실패합니다. 이 칸은 우리 설정이 아니라 네트워크 정책입니다.
# (여기에 적을 것은 없고, 열렸는지는 GET /ops/cutover의 도달 점검이 말합니다)

# ── 3. Validation Environment (사람이 줘야 함) ──────────────────────────
# 실 호출은 돈이 나가고 외부에 흔적을 남깁니다. 개발자 노트북에서 운영 키로
# 스모크를 돌리는 것은 검증이 아니라 사고입니다.
DEPLOY_TIER=staging
NODE_ENV=production
# 검증 대상 주소. 운영 호스트·자기 자신·사설망은 확인을 받아도 거부됩니다.
VALIDATION_TARGET_URL=
# 주소를 적는 것과 그곳에 돈이 나가는 호출을 돌려도 된다고 말하는 것은 다른
# 행동입니다 — 그래서 확인 값을 따로 받습니다(대상 호스트와 같아야 합니다).
VALIDATION_TARGET_ACK=

# ── 4. Production Host Inventory (사람이 줘야 함) ───────────────────────
# 검증 대상 보호는 이 목록과 대조해 동작합니다. 비어 있으면 보호가 지켜 주는
# 것이 아니라 그냥 통과시키고 있는 것입니다.
# **시스템은 이 목록을 자동으로 채우지 않습니다** — 관측한 호스트를 자동
# 등록하면 보호가 스스로 무력해지고, Host 헤더는 요청하는 쪽이 적는 값이라
# 바깥에서 우리 목록에 글을 쓰는 셈이 됩니다(정책 4201-① · 4301-①).
PRODUCTION_HOSTS=
PUBLIC_BASE_URL=

# ── 5. 신뢰하는 프록시 (선택 — TASK-4401 정책 ①) ────────────────────────
# 리버스 프록시가 Host를 바꿔 전달하는 구성이라면, 여기에 프록시 주소를
# 선언해야 X-Forwarded-Host를 봅니다. **선언이 없으면 보지 않습니다** —
# 기본값은 언제나 "안 믿는다"입니다.
# 단일 IP 또는 CIDR을 쉼표로: 10.0.0.5,192.168.1.0/24
# (0.0.0.0/0은 신뢰 경계가 아니라 경계를 없앤 것이므로 맞지 않는 것으로 봅니다)
TRUSTED_PROXY_IPS=

# ── 6. 긴급 알림 경로 ───────────────────────────────────────────────────
# 검증 스프린트는 실패를 만들려고 하는 기간입니다. 그 실패가 일반 채널에
# 묻히면 검증하는 사람이 가장 늦게 압니다.
ALERT_URGENT_WEBHOOK_URL=
