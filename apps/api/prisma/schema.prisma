generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String    @id @default(cuid())
  name        String
  description String?
  contents    Content[]
  images      Image[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("products")
}

model Image {
  id           String     @id @default(cuid())
  key          String     @unique
  url          String
  originalName String
  mimeType     String
  size         Int
  product      Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId    String?
  ocrResult    OcrResult?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([productId])
  @@map("images")
}

model OcrResult {
  id          String    @id @default(cuid())
  image       Image     @relation(fields: [imageId], references: [id], onDelete: Cascade)
  imageId     String    @unique
  provider    String
  status      OcrStatus @default(PENDING)
  text        String?
  confidence  Float? // 0.0 ~ 1.0
  raw         Json? // Provider 원본 응답
  error       String?
  attempts    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@map("ocr_results")
}

enum OcrStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Content {
  id        String        @id @default(cuid())
  title     String
  body      String
  status    ContentStatus @default(DRAFT)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([productId])
  @@map("contents")
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}
