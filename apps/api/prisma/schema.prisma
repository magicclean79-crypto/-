generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 최상위 루트 엔티티 — 여러 상품과 Product Object 버전을 묶는 작업 단위 (TASK-0301)
model Project {
  id              String          @id @default(cuid())
  name            String
  description     String?
  products        Product[]
  productObjects  ProductObject[]
  contents        Content[]
  sopRuns         SopRun[]
  decisions       Decision[]
  projectMemories ProjectMemory[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("projects")
}

model Product {
  id              String           @id @default(cuid())
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  name            String
  description     String?
  images          Image[]
  analysisResults AnalysisResult[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([projectId])
  @@map("products")
}

// Product Object — OCR/Vision 결과를 조립한 정규화 데이터 모델. Project별 버전 관리.
model ProductObject {
  id            String              @id @default(cuid())
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  version       Int
  status        ProductObjectStatus @default(DRAFT)
  title         String
  brand         String?
  category      String?
  attributes    Json?
  ocrSummary    Json?
  visionSummary Json?
  metadata      Json?
  contents      Content[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([projectId, version])
  @@index([projectId])
  @@index([status])
  @@map("product_objects")
}

enum ProductObjectStatus {
  DRAFT
  READY
  ARCHIVED
}

model AnalysisResult {
  id          String         @id @default(cuid())
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  provider    String
  status      AnalysisStatus @default(PENDING)
  result      Json? // 구조화된 ProductAnalysis
  rawJson     Json? // Provider 원본 응답
  error       String?
  attempts    Int            @default(0)
  applied     Boolean        @default(false)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([productId])
  @@index([status])
  @@map("analysis_results")
}

enum AnalysisStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model Image {
  id           String      @id @default(cuid())
  key          String      @unique
  url          String
  originalName String
  mimeType     String
  size         Int
  product      Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId    String?
  ocrResults   OcrResult[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([productId])
  @@map("images")
}

model OcrResult {
  id            String    @id @default(cuid())
  image         Image     @relation(fields: [imageId], references: [id], onDelete: Cascade)
  imageId       String
  provider      String
  status        OcrStatus @default(PENDING)
  // 0.0 ~ 1.0 — **Provider가 주지 않으면 null**(TASK-2901): 1.0은 "확신한다"는
  // 거짓이고 0은 실패처럼 읽힌다. 모른다는 사실이 뒤까지 전달되어야 한다.
  confidence    Float?
  // 예상 비용(USD) — 가격표에 없는 엔진은 null (TASK-3001, CTO 결정 2901-④).
  // null은 "공짜"가 아니라 "모른다"다: 예산 계산에서 빠지므로 미산정 경보 대상.
  cost          Decimal?  @db.Decimal(12, 6)
  // 과금 단위 수 (이미지 1장 · 검사 1종 = 1)
  units         Int       @default(1)
  extractedText String?
  rawJson       Json? // Provider 원본 응답
  error         String?
  attempts      Int       @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  /**
   * 실제 호출 대상 (TASK-3501, CTO 정책 3501-④·⑤) — Execution과 같은 이유다.
   * OCR도 같은 판정(`/ops/cutover`)의 근거가 되므로 같은 칸을 둔다.
   */
  endpoint      String?
  baseUrl       String?
  calledAt      DateTime?
  /**
   * 요청 추적 (TASK-3601, CTO 정책 3601-②) — Execution과 같은 이유다
   */
  requestId     String?
  traceId       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([imageId])
  @@index([status])
  // 일·월 예산 집계가 기간으로 자른다 (TASK-3001)
  @@index([createdAt])
  // 전환 판정이 "공식 주소로 성공한 기록"을 센다 (TASK-3501)
  @@index([provider, baseUrl, createdAt])
  // 한 요청이 부른 호출을 모아 본다 (TASK-3601)
  @@index([requestId])
  @@map("ocr_results")
}

enum OcrStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

// 상세페이지 콘텐츠 — Product Object를 단일 입력으로 생성된다 (TASK-0303)
model Content {
  id               String                   @id @default(cuid())
  project          Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId        String
  productObject    ProductObject?           @relation(fields: [productObjectId], references: [id], onDelete: SetNull)
  productObjectId  String?
  title            String
  body             String
  status           ContentStatus            @default(DRAFT)
  publishedAt      DateTime? // **최초** 발행 시각 (TASK-0703) — 한 번 기록되면 바뀌지 않는다
  // 마지막 발행 시각 (TASK-2801, CTO 결정 2701-②) — 발행할 때마다 갱신.
  // 최초 발행 시각만으로는 "지금 언제부터 나가 있는가"에 답할 수 없다:
  // 내렸다 고쳐 다시 올린 콘텐츠는 옛 날짜를 보여 준다.
  // null인데 publishedAt이 있으면 **이 값을 두기 전에 발행된 것**이다.
  lastPublishedAt  DateTime?
  statusHistory    ContentStatusHistory[]
  governanceChecks ContentGovernanceCheck[] // 발행 거버넌스 판정 기록 (TASK-2501)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([projectId])
  @@map("contents")
}

// 발행 거버넌스 판정 기록 (TASK-2501) — 발행 시도 1건당 1레코드.
// 삭제하지 않는다: 규칙은 나중에 바뀌므로 "그때의 기준"이 남아 있어야
// "왜 이게 발행됐지"에 답할 수 있다. 막힌 기록도 남는다.
model ContentGovernanceCheck {
  id           String    @id @default(cuid())
  content      Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId    String
  status       String // PASS | WARNING | FAIL (판정 등급은 READY 판정과 같다)
  published    Boolean   @default(false) // 이 판정으로 실제 발행이 이뤄졌는가
  blockedBy    String[] // 막은 검사의 key 목록 — 빈 배열이면 막힌 것이 없다
  checks       Json // 판정 당시 검사 결과 전체
  appliedRules Json // 판정에 실제로 쓰인 기준 (금지어 수·적용 고지 id)
  actor        String? // 수행자 이메일
  createdAt    DateTime  @default(now())
  // 보관 시각 (TASK-2601, CTO 결정 2501-⑤) — 90일 경과 후 보관.
  // 삭제가 아니다: 현황 조회에서 비켜 두되 이력은 남는다.
  archivedAt   DateTime?

  @@index([contentId, createdAt])
  @@index([archivedAt, createdAt])
  @@map("content_governance_checks")
}

// 예약 위반 스캔 실행 기록 (TASK-2701, CTO 결정 2601-②③).
// 지난 결과와 비교해 **늘었을 때만** 경보하려면 지난 결과가 남아 있어야 한다.
// 범위(scope)별로 따로 센다 — 프로젝트 하나가 나빠진 것과 전체가 나빠진
// 것을 한 기준으로 비교하면 어디가 나빠졌는지 알 수 없다.
model GovernanceScanRun {
  id                  String   @id @default(cuid())
  // "all" 또는 "project:<id>" — 비교 기준을 가르는 키
  scope               String
  scanned             Int
  blocked             Int
  publishedViolations Int
  warned              Int
  clean               Int
  // 검사별 집계 — 무엇이 늘었는지 나중에 되짚을 근거
  byCheck             Json
  // 지난 결과와 비교한 판정 (baseline | increased | decreased | unchanged | resolved)
  verdict             String
  // 직전 위반 총합 — 첫 스캔이면 null
  previousTotal       Int?
  total               Int
  alerted             Boolean  @default(false)
  trigger             String // schedule | manual
  // 위반 콘텐츠 id 목록 (TASK-2801, CTO 결정 2701-⑤) — 다음 실행이 "새로
  // 위반된 것"을 가리는 근거. **null은 목록을 남기지 않은 실행**(TASK-2701
  // 이전)이고 빈 배열("위반이 없었다")과 다르다.
  violatingIds        Json?
  // 새로 위반된 콘텐츠: 표본(최대 10건) + 전체 수. null은 "가릴 수 없었다".
  newly               Json?
  newlyCount          Int?
  // 지난 실행에는 있었으나 이번에 사라진 위반 수 — 총량이 같아도 구성이
  // 바뀔 수 있고, 그 사실이 없으면 조용했던 실행을 나중에 설명할 수 없다
  resolvedCount       Int?
  createdAt           DateTime @default(now())

  @@index([scope, createdAt])
  @@map("governance_scan_runs")
}

// 가격표 변경 제안 (TASK-3101, CTO 정책 3101-①) — 검토 → 승인 → 적용.
//
// 단가는 **앞으로의 계산 기준**이고, 이미 기록된 비용은 수정하지 않는다
// (Append Only, 정책 3101-②). 그래서 이 표는 "언제부터 어떤 단가였는가"의
// 이력이 되고, 비용 검증은 **그 시점에 유효했던 단가**로 대조한다.
model PricingProposal {
  id              String    @id @default(cuid())
  target          String // llm | ocr
  key             String // LLM은 모델 이름, OCR은 엔진 이름
  price           Json // 제안 단가
  // 출처 (TASK-3201) — manual(사람) | detected(자동 감지).
  // 가르지 않으면 자동화가 만든 제안을 사람이 낸 것처럼 읽는다.
  origin          String    @default("manual")
  // 감지 근거 (표본 수·기간·표본 id·차이) — 근거 없는 제안은 승인할 수 없다
  evidence        Json?
  // 제안 당시의 유효 단가 — 가격표에 없던 항목이면 null.
  currentPrice    Json?
  reason          String
  // 단계를 건너뛸 수 없다 (검토 없이 승인·승인 없이 적용 금지)
  stage           String    @default("DRAFT")
  proposedBy      String?
  reviewedBy      String?
  reviewedAt      DateTime?
  approvedBy      String?
  approvedAt      DateTime?
  // 2차 승인 (TASK-3301, CTO 정책 3301-②) — 시스템이 만든 제안은 운영에서
  // 다른 ADMIN의 최종 승인을 한 번 더 거친다
  confirmedBy     String?
  confirmedAt     DateTime?
  appliedBy       String?
  appliedAt       DateTime?
  // 발효 시각 (TASK-3201, CTO 정책 3201-③) — 적용은 결정이고 발효는 시각이다.
  // 미래로 예약되면 그 시각까지 어떤 계산에도 쓰이지 않는다.
  effectiveFrom   DateTime?
  // 예약 취소 (TASK-3301, CTO 정책 3301-③) — 삭제하지 않고 남긴다
  cancelledBy     String?
  cancelledAt     DateTime?
  cancelledReason String?
  rejectedBy      String?
  rejectedAt      DateTime?
  rejectedReason  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // 실효 단가 해석이 **발효된** 것만 시각순으로 읽는다 (TASK-3201)
  @@index([target, key, effectiveFrom])
  @@index([target, key, appliedAt])
  @@index([stage, createdAt])
  @@map("pricing_proposals")
}

// 가격 감지 실행 이력 (TASK-3301, CTO 정책 3301-④)
//
// Provider별 주기를 지키려면 "언제 마지막으로 봤는가"가 있어야 하고, 이 기록이
// 없으면 **"감지 0건"과 "감지를 안 돌렸다"를 구분할 수 없다** — 조용한 것과
// 안 본 것은 다르다.
model PriceDetectionRun {
  id        String   @id @default(cuid())
  target    String // llm | ocr
  provider  String // 프로젝트별 구분은 두지 않는다 (정책 3301-④)
  source    String // records | published
  ranAt     DateTime @default(now())
  samples   Int      @default(0)
  changes   Int      @default(0)
  skipped   String? // 건너뛴 이유 — 돌지 않은 것도 기록이다
  detail    String
  createdAt DateTime @default(now())

  @@index([provider, ranAt])
  @@index([ranAt])
  @@map("price_detection_runs")
}

// 발행 파이프라인 감사 이력 (TASK-0704) — 상태 전이 1건당 1레코드
model ContentStatusHistory {
  id         String        @id @default(cuid())
  content    Content       @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId  String
  fromStatus ContentStatus
  toStatus   ContentStatus
  actor      String? // 수행자 이메일 (TASK-0801 Actor Audit) — 인증 도입 전 기록은 null
  createdAt  DateTime      @default(now())

  @@index([contentId, createdAt])
  @@map("content_status_history")
}

// ── 인증/권한 Foundation (TASK-0801, Sprint 8) ─────────

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  name             String
  passwordHash     String
  role             UserRole      @default(VIEWER)
  disabled         Boolean       @default(false) // 비활성화 시 로그인/세션 무효 (TASK-0802)
  failedLoginCount Int           @default(0) // 연속 로그인 실패 횟수 (TASK-0804 잠금)
  lockedUntil      DateTime? // 이 시각까지 로그인 잠금 (TASK-0804, null=잠금 없음)
  sessions         AuthSession[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("users")
}

// 사용자 관리 감사 로그 (TASK-0802) — 생성/역할 변경/비활성화 1건당 1레코드
model UserAuditLog {
  id          String   @id @default(cuid())
  actor       String // 수행자 이메일
  action      String // USER_CREATED | ROLE_CHANGED | USER_DISABLED | USER_ENABLED
  targetEmail String
  detail      String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("user_audit_log")
}

// DB 저장형 세션 — 토큰 1개당 1레코드, 만료 시각으로 무효화
model AuthSession {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("auth_sessions")
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

// SOP 실행 이력 — 표준 절차 1회 실행의 단계별 결과 (TASK-0305)
model SopRun {
  id          String       @id @default(cuid())
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  sopKey      String
  status      SopRunStatus @default(RUNNING)
  steps       Json // 단계별 결과 (SopStepResultDto[])
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([projectId])
  @@map("sop_runs")
}

enum SopRunStatus {
  RUNNING
  DONE
  FAILED
}

// 의사결정 로그 — 프로젝트별 결정 기록 (TASK-0306)
model Decision {
  id           String       @id @default(cuid())
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String
  title        String
  description  String?
  reason       String
  decisionType DecisionType
  author       String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([projectId])
  @@map("decisions")
}

// 프로젝트 메모형 기억 — 구 Memory(TASK-0307)를 TASK-0402에서 개칭·보존
model ProjectMemory {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  title     String
  content   String
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("project_memories")
}

// 표준 Structured Memory — Company Brain의 구조화 저장소 (TASK-0402)
model Memory {
  id          String      @id @default(cuid())
  scope       MemoryScope
  scopeId     String?
  key         String
  value       Json
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([scope, scopeId, key])
  @@index([scope, scopeId])
  @@map("memories")
}

// Memory 적용 범위 — CTO 결정으로 Enum 고정 (TASK-0402 승인 리뷰)
enum MemoryScope {
  GLOBAL
  COMPANY
  PROJECT
  PRODUCT
}

// 회사 공식 지식 — Company Brain 전역 (프로젝트 무관, TASK-0401)
model Knowledge {
  id        String             @id @default(cuid())
  title     String
  content   String
  category  KnowledgeCategory?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([category])
  @@map("knowledge")
}

// 지식 분류 — CTO 결정으로 Enum 고정 (TASK-0401 승인 리뷰)
enum KnowledgeCategory {
  RULE
  POLICY
  GUIDE
  BRAND
  LEGAL
  QUALITY
  FAQ
  OTHER
}

// 결정 유형 — CTO 결정으로 Enum 고정 (TASK-0306 승인 리뷰)
enum DecisionType {
  ARCHITECTURE
  PROCESS
  PRODUCT
  BUSINESS
  TECHNICAL
  QUALITY
  SECURITY
  OTHER
}

// ── Execution Domain (TASK-0601, Sprint 6) ─────────────
// 모든 LLM 호출(Content/Analysis/Vision/개발용) 1건당 1레코드 — 관측 전용
enum ExecutionStatus {
  SUCCESS
  FAILED
}

model Execution {
  id           String          @id @default(cuid())
  feature      String // content-generation | product-analysis | vision-analysis | dev
  provider     String
  model        String
  status       ExecutionStatus
  inputTokens  Int?
  outputTokens Int?
  cost         Decimal?        @db.Decimal(12, 6) // 예상 비용(USD) — 가격표 없는 모델은 null
  latencyMs    Int
  error        String?
  // 진단 호출(Health Check·Live Check) 여부 — CTO 결정 1301-③.
  // feature를 새로 만들지 않고 메타데이터로 구분해 운영 통계에서 분리한다.
  diagnostic   Boolean         @default(false)
  /**
   * 실제 호출 대상 (TASK-3501, CTO 정책 3501-④·⑤).
   * 이 세 칸이 없으면 "이 성공 기록이 **누구를 상대로** 만들어졌는가"에 답할
   * 수 없다. TASK-3501 라이브 검증에서 판정이 과거에 심어 둔 행을 근거로
   * "전환 완료"라고 말할 뻔했고, 그 사고의 뿌리가 여기였다.
   * 옛 기록은 null이며, **null은 "공식 주소였다"가 아니라 "모른다"** 이다.
   */
  endpoint     String?
  baseUrl      String?
  calledAt     DateTime?
  /**
   * 요청 추적 (TASK-3601, CTO 정책 3601-②).
   * 한 번의 사용자 요청이 부른 호출들을 묶는 끈이다. 없으면 "이 요청이
   * 얼마를 썼는가"·"이 실패가 그 요청의 것인가"에 답할 수 없다.
   * 모르면 null — 지어내지 않는다.
   */
  requestId    String?
  traceId      String?
  createdAt    DateTime        @default(now())

  @@index([feature, createdAt])
  @@index([diagnostic, createdAt])
  // 전환 판정이 "공식 주소로 성공한 기록"을 센다 (TASK-3501)
  @@index([provider, baseUrl, createdAt])
  // 한 요청이 부른 호출을 모아 본다 (TASK-3601)
  @@index([requestId])
  @@map("executions")
}

// ── Production Automation & Alerting (TASK-1302, Sprint 13) ──

enum AlertLevel {
  WARNING
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  RESOLVED
  // 해소 후 유예(기본 90일)가 지나면 보관 — **삭제하지 않는다**(CTO 결정 1302-④)
  ARCHIVED
}

/**
 * 경보 1건 — `key`가 같으면 같은 문제로 본다(중복 알림 방지).
 * 해소되면 RESOLVED로 남기고 지우지 않는다 — 언제 났다가 언제 풀렸는지가
 * 사고 분석의 근거다.
 */
model Alert {
  id            String      @id @default(cuid())
  kind          String // budget | provider-failure | unpriced-model | configuration
  key           String      @unique // 중복 판정 키 (예: provider-failure:openai)
  level         AlertLevel
  title         String
  message       String
  status        AlertStatus @default(ACTIVE)
  /**
   * 같은 경보가 다시 감지된 횟수
   */
  occurrences   Int         @default(1)
  firstRaisedAt DateTime    @default(now())
  lastRaisedAt  DateTime    @default(now())
  /**
   * 마지막으로 외부 채널에 알린 시각 (재알림 쿨다운 기준)
   */
  notifiedAt    DateTime?
  resolvedAt    DateTime?

  archivedAt DateTime?

  @@index([status, lastRaisedAt])
  @@index([kind, lastRaisedAt])
  @@map("alerts")
}

/**
 * 알림 전송 시도 1건 (TASK-1401).
 * 전송이 **실패한 사실 자체가 알려지지 않는 것**이 TASK-1302의 구멍이었다.
 * 채널·시도 횟수·마지막 오류를 남겨 "왜 아무도 못 받았는가"를 추적한다.
 */
model NotificationDelivery {
  id        String   @id @default(cuid())
  /**
   * 경보 키 (alerts.key) — 삭제 연쇄를 만들지 않으려 FK를 걸지 않는다
   */
  alertKey  String
  channel   String // slack | email | webhook
  level     String // warning | critical | resolved
  /**
   * 최종 성공 여부
   */
  ok        Boolean
  /**
   * 총 시도 횟수 (최초 1회 포함)
   */
  attempts  Int      @default(1)
  /**
   * 마지막 응답 상태 — 네트워크 오류면 null
   */
  status    Int?
  error     String?
  createdAt DateTime @default(now())

  @@index([alertKey, createdAt])
  @@index([channel, createdAt])
  @@map("notification_deliveries")
}

enum NotificationQueueStatus {
  PENDING
  SENT
  /**
   * Dead Letter — 사람이 고쳐야 나간다. **지우지 않는다**
   */
  DEAD
  /**
   * 90일이 지난 Dead Letter — 보관 (CTO 결정 1501-③, 삭제 아님)
   */
  ARCHIVED
}

/**
 * 알림 전송 큐 (TASK-1501, CTO 결정 1401-②).
 * TASK-1401의 재시도는 프로세스 안에서만 돌아서, 인스턴스가 재시작하면
 * 진행 중이던 재시도가 사라졌다. 큐에 담아 두면 **재시작을 견딘다**.
 */
model NotificationQueue {
  id            String                  @id @default(cuid())
  alertKey      String
  channel       String // slack | email | webhook
  level         String // warning | critical | resolved
  /**
   * 전송 본문 (채널 무관 표현) — 재시도 때 그대로 다시 쓴다
   */
  payload       Json
  status        NotificationQueueStatus @default(PENDING)
  attempts      Int                     @default(0)
  /**
   * 다음 시도 시각 — Retry Worker가 이 시각을 지난 항목만 집어 간다
   */
  nextAttemptAt DateTime                @default(now())
  lastStatus    Int?
  lastError     String?
  sentAt        DateTime?
  deadAt        DateTime?
  archivedAt    DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([status, nextAttemptAt])
  @@index([alertKey, createdAt])
  @@map("notification_queue")
}

/**
 * 백업 실행 이력 (TASK-1601).
 * **크기를 남기는 이유**: "성공"이라도 0바이트면 복원할 수 없다.
 */
model BackupRun {
  id              String    @id @default(cuid())
  ok              Boolean
  /**
   * 덤프 크기 (bytes) — 실패면 null
   */
  sizeBytes       BigInt?
  /**
   * 저장 경로 (파일명만 — 절대 경로는 노출하지 않는다)
   */
  fileName        String?
  durationMs      Int
  trigger         String    @default("schedule")
  error           String?
  /**
   * 덤프 SHA-256 — 같은 파일인지 확인한다 (TASK-1701)
   */
  checksum        String?
  /**
   * pg_restore --list로 읽히는가 — 확인하지 못했으면 null
   */
  integrityOk     Boolean?
  /**
   * 덤프 안에서 확인한 객체 수
   */
  entries         Int?
  /**
   * 오브젝트 저장소에 복제된 키 — 복제하지 않았으면 null
   */
  offsiteKey      String?
  /**
   * 원격 사본을 내려받아 대조한 시각 (TASK-2101, CTO 결정 2001-②)
   */
  remoteCheckedAt DateTime?
  /**
   * 대조 결과 — ok · mismatch · missing
   */
  remoteVerdict   String?
  createdAt       DateTime  @default(now())

  @@index([createdAt])
  @@index([remoteCheckedAt])
  @@map("backup_runs")
}

/**
 * 복원 검증 이력 (TASK-1601).
 * **복원해 보지 않은 백업은 백업이 아니다** — 그 확인의 기록이다.
 */
model RestoreRun {
  id         String   @id @default(cuid())
  ok         Boolean
  /**
   * 복원 후 확인한 테이블 수
   */
  tables     Int?
  /**
   * 검증에 쓴 백업 파일
   */
  fileName   String?
  durationMs Int
  trigger    String   @default("schedule")
  error      String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("restore_runs")
}

/**
 * 복구 리허설 기록 (TASK-1801, CTO 결정 1701-⑤).
 * 분기 1회 실제 복구를 해 보고 결과를 남긴다. 절차를 읽는 것과 해 보는 것은
 * 다르고, 기록하지 않으면 "했다"는 말만 남는다.
 */
model RecoveryDrill {
  id          String   @id @default(cuid())
  /**
   * 절차대로 복구에 성공했는가
   */
  ok          Boolean
  /**
   * 수행자 (감사용)
   */
  performedBy String
  /**
   * 소요 시간 — 실제 RTO의 근거
   */
  durationMs  Int?
  /**
   * 발견 사항 — 절차의 어디가 어긋났는지
   */
  findings    String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("recovery_drills")
}

/**
 * 리허설을 즉시 요구하는 변경 사건 (TASK-1901, CTO 결정 1801-⑤).
 * 90일 주기는 "아무것도 바뀌지 않았을 때"의 간격이다. DR 절차·DB·백업 방식이
 * 크게 바뀌면 마지막 리허설이 검증한 것은 지금의 시스템이 아니다.
 */
model DrillRequirement {
  id           String    @id @default(cuid())
  /**
   * dr-change | db-major-change | pitr-adoption
   */
  trigger      String
  /**
   * 무엇이 바뀌었는지
   */
  description  String
  registeredBy String
  /**
   * 이 요구를 충족한 리허설 시각 — 미해소면 null
   */
  satisfiedAt  DateTime?
  /**
   * 충족한 리허설 id
   */
  satisfiedBy  String?
  /**
   * 취소 (TASK-2001, CTO 결정 1901-②).
   * **삭제는 금지한다** — 잘못 등록한 것도 기록으로 남아야 한다.
   */
  cancelledAt  DateTime?
  cancelledBy  String?
  cancelReason String?
  createdAt    DateTime  @default(now())

  @@index([satisfiedAt])
  @@map("drill_requirements")
}

/**
 * 예약 점검 실행 이력 — "언제 마지막으로 확인했는가"의 근거
 */
model CheckRun {
  id           String   @id @default(cuid())
  job          String // cost-verification | provider-validation | health-check
  ok           Boolean
  detail       String
  alertsRaised Int      @default(0)
  durationMs   Int
  /**
   * 예약 실행인지 수동 실행인지
   */
  trigger      String   @default("schedule")
  createdAt    DateTime @default(now())

  @@index([job, createdAt])
  @@map("check_runs")
}

// ── Experiment Lifecycle & Sticky Assignment (TASK-1101, Sprint 11) ──

enum ExperimentStatus {
  RUNNING // 배정 진행 — 실험 정의(환경변수)가 있으면 기본 상태
  STOPPED // 중단 — 배정하지 않고 기존 라우팅으로 처리
  PROMOTED // 승자 확정 — 전 트래픽을 승자 변형으로 보낸다
}

// feature별 실험의 운영 상태. 정의(변형·가중치)는 환경변수가 원천이고
// (CTO 결정 1003-②로 표기법 확정), 이 표는 **운영 중 바뀌는 상태**만 갖는다.
// 행이 없으면 RUNNING으로 본다 (TASK-1003 동작 보존).
model ExperimentState {
  id                 String           @id @default(cuid())
  feature            String           @unique
  status             ExperimentStatus @default(RUNNING)
  // 승자 변형 키 (`provider` 또는 `provider:model`) — PROMOTED일 때만 유효
  promotedVariant    String?
  actor              String? // 마지막 조작자 (이메일)
  note               String?
  // 관측 기간 기준 (TASK-1201, CTO 결정 1102-③): 실험 정의 서명이 바뀔 때만
  // 초기화한다 — START/STOP은 기간을 이어간다.
  signature          String?
  signatureChangedAt DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  events      ExperimentEvent[]
  assignments ExperimentAssignment[]

  @@map("experiment_states")
}

// 상태 전이 이력 — Rollback은 이 이력의 직전 상태로 되돌린다 (감사 겸용)
model ExperimentEvent {
  id          String           @id @default(cuid())
  stateId     String
  state       ExperimentState  @relation(fields: [stateId], references: [id], onDelete: Cascade)
  action      String // START | STOP | PROMOTE | ROLLBACK
  fromStatus  ExperimentStatus
  toStatus    ExperimentStatus
  fromVariant String?
  toVariant   String?
  actor       String?
  note        String?
  createdAt   DateTime         @default(now())

  @@index([stateId, createdAt])
  @@map("experiment_events")
}

// Project 기반 Sticky Assignment — 같은 프로젝트는 항상 같은 변형을 받는다.
// 배정은 결정적 해시로 정해지므로 이 표가 없어도 결과는 같고, 표는
// **관측·감사(Assignment Dashboard)** 를 위해 남긴다.
model ExperimentAssignment {
  id         String          @id @default(cuid())
  stateId    String
  state      ExperimentState @relation(fields: [stateId], references: [id], onDelete: Cascade)
  feature    String
  projectId  String
  variantKey String
  // 배정이 만들어진 시점의 실험 정의 서명 — 정의가 바뀌면 재배정한다
  signature  String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([feature, projectId])
  @@index([feature, variantKey])
  @@map("experiment_assignments")
}

// 배정 변경 감사 (TASK-1102, CTO 결정 1101-⑤).
// 실험 정의(변형·가중치)가 바뀌면 기존 Sticky 배정이 무효가 되어 다시
// 배정되는데, 그 변화를 조용히 넘기지 않고 이력으로 남긴다.
model ExperimentAssignmentEvent {
  id            String   @id @default(cuid())
  feature       String
  projectId     String
  reason        String // DEFINITION_CHANGED | VARIANT_UNAVAILABLE
  fromVariant   String?
  toVariant     String
  fromSignature String?
  toSignature   String
  createdAt     DateTime @default(now())

  @@index([feature, createdAt])
  @@map("experiment_assignment_events")
}

// ── Provider Administration Console (TASK-1201, Sprint 12) ──

// 운영 중 변경 가능한 설정 오버라이드.
// 원칙은 그대로 **Code-first(환경변수)** 이고, 이 표는 그 위에 얹는
// **운영 오버라이드**다: 값이 있으면 우선하고, 지우면 환경변수로 되돌아간다.
// (행이 없으면 기존 동작 그대로 — 콘솔을 쓰지 않는 환경은 영향이 없다)
model AdminSetting {
  key       String   @id // provider.<name>.enabled | model.<feature> | budget.daily | experiment.<feature>
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("admin_settings")
}

// 콘솔 조작 감사 — 누가 무엇을 어떤 값에서 어떤 값으로 바꿨는지
model AdminAuditLog {
  id        String   @id @default(cuid())
  actor     String?
  action    String // SETTING_UPDATED | SETTING_CLEARED
  key       String
  before    String?
  after     String?
  note      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("admin_audit_log")
}

// ── 운영 활성화 이력 · 스모크 · 장애 이력 (TASK-3701, Sprint 37) ──

/**
 * 활성화 상태 구간 (CTO 정책 3701-①).
 * 한 줄 = 하나의 상태 구간이다. `/ops/activation`은 화면을 열 때마다 불리므로
 * 매번 적으면 같은 문장 수천 줄이 되고 그 안에서 **변화**가 보이지 않는다.
 * 그래서 지문(`signature`)이 바뀔 때만 새 줄을 만들고, 같은 상태를 다시 보면
 * `lastSeenAt`·`observations`만 갱신한다.
 * `lastSeenAt`이 따로 있는 이유: 그것이 없으면 "3주째 그대로"가 3주 내내
 * 확인한 결과인지 3주 동안 아무도 안 본 결과인지 구분할 수 없다.
 */
model ActivationEvent {
  id           String   @id @default(cuid())
  /// activated + 충족 조건 집합 — 같으면 같은 구간
  signature    String
  activated    Boolean
  /// 그때 충족돼 있던 조건 (credentials · network · cutover)
  met          String[] @default([])
  environment  String
  detail       String
  recordedAt   DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  observations Int      @default(1)

  @@index([recordedAt])
  @@map("activation_events")
}

/**
 * 운영 스모크 1회 (CTO 정책 3701-②).
 * 실 Provider·실 저장소를 **실제로 불러 본** 기록이다. 키 형식·주소·도달·
 * 성공 기록이 다 통과해도 "지금 부르면 되는가"에는 답하지 못한다.
 * `baseUrl`을 함께 적는 이유는 TASK-3401에서 겪은 것 때문이다 — 스텁을
 * 상대로 받은 200은 우리 스텁이 살아 있다는 증거이지 Provider가 붙었다는
 * 증거가 아니다.
 */
model SmokeRun {
  id        String   @id @default(cuid())
  /// llm | ocr | storage
  target    String
  /// passed | failed | stubbed | skipped
  status    String
  provider  String
  /// 실제로 부른 주소의 기준점 — 모르면 null (null은 "공식이었다"가 아니다)
  baseUrl   String?
  latencyMs Int?
  detail    String
  /// 누가 눌렀는가 — 실 호출은 돈이 나가므로 책임자가 남아야 한다
  actorId   String?
  requestId String?
  createdAt DateTime @default(now())

  @@index([target, createdAt])
  @@map("smoke_runs")
}

/**
 * 운영 장애 (CTO 정책 3701-④).
 * 경보(`Alert`)는 자동으로 뜨는 **신호**이고, 장애는 사람이 여는 **사건**이다.
 * 경보에서 장애를 자동으로 뽑으려는 시도는 늘 둘 중 하나로 끝난다 — 아무것도
 * 아닌 것이 장애가 되거나, 조용히 지나간 진짜 장애가 빠지거나.
 * `resolvedAt`이 null이면 진행 중이고, 그 지속 시간은 최종값이 아니라
 * **지금까지**다. `recovery` 없이는 닫지 않는다 — 무엇으로 살렸는지 적히지
 * 않은 종료 기록은 다음 장애 때 아무 도움이 되지 않는다.
 */
model Incident {
  id                String    @id @default(cuid())
  /// llm | ocr | storage | database | queue | web | api | other
  component         String
  /// MINOR | MAJOR | CRITICAL
  severity          String
  summary           String
  /// 장애가 시작된 시각 — 우리가 알아챈 시각이 아니다
  startedAt         DateTime
  /// 우리가 알아챈 시각 — 모르면 null. 이 간격이 크면 고칠 곳은 감시다
  detectedAt        DateTime?
  /// 복구 시각 — null이면 진행 중
  resolvedAt        DateTime?
  cause             String?
  recovery          String?
  /**
   * 사후 분석 (TASK-3801, CTO 정책 3801-②).
   * 재시작으로 살린 것과 원인을 없앤 것이 목록에서 똑같이 "복구됨"으로
   * 보이면, 팀은 자기가 **몇 개의 시한폭탄을 안고 있는지** 모른다.
   * `fixKind`가 그 둘을 가르고, 나머지 넷은 조사해서 알아낸 것을 담는다.
   * 옛 기록은 전부 null이며 **null은 "영구 조치였다"가 아니라 "모른다"** 이다.
   */
  /**
   * /**
   * /**
   * 초안인가 확인된 장애인가 (TASK-3901, CTO 정책 3901-⑤).
   * 경보에서 자동으로 만드는 것은 **초안**이지 장애가 아니다 — "이건
   * 장애였을 수 있습니다, 봐 주세요"라는 질문이다. 초안은 MTTR에 들어가지
   * 않고, 사람이 확인하면 장애가 되고 기각하면 **사유와 함께** 남는다.
   */
  /// DRAFT | CONFIRMED | DISMISSED
  status            String    @default("CONFIRMED")
  /// 어느 경보에서 왔는가 — 같은 경보로 두 번 만들지 않는다 (표가 막는다)
  sourceAlertKey    String?   @unique
  dismissedAt       DateTime?
  dismissReason     String?
  dismissedById     String?
  /**
   * 아무도 판단하지 않은 채 수명을 넘긴 시각 (TASK-4001, CTO 정책 4001-①).
   * **기각이 아니다.** 기각은 "아무것도 아니었다"는 사람의 판단이고, 이것은
   * "아무도 판단하지 않았다"는 사실이다. 둘을 같은 칸에 넣으면 나중에
   * 이력을 읽는 사람이 "우리 팀은 초안을 잘 기각한다"고 잘못 읽는다.
   */
  expiredAt         DateTime?
  /**
   * 만료된 초안을 되살린 기록 (TASK-4101, CTO 정책 4101-④).
   * **`expiredAt`을 지우지 않는다** — 만료됐던 사실을 지우면 목록은
   * 깨끗해지고 이력은 "확인된 장애 1건"이 된다. 그러면 나중에 이력을 읽는
   * 사람이 "우리 팀은 초안을 잘 처리한다"고 읽는다. 실제로는 늦게 본
   * 것인데도. 예외는 `reopen`(만료 취소)이며, 그때도 되살린 기록은 남는다.
   */
  revivedAt         DateTime?
  revivedById       String?
  /// confirm | dismiss | reopen
  revivalAction     String?
  revivalReason     String?
  /// 만료 뒤 얼마나 지나서 손댔는가 (ms) — 하루와 석 달을 구분한다
  revivalLatenessMs Int?
  /// temporary | permanent — 닫을 때 반드시 고른다
  fixKind           String?
  rootCause         String?
  temporaryFix      String?
  permanentFix      String?
  prevention        String?
  openedById        String?
  resolvedById      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([resolvedAt, startedAt])
  @@index([component, startedAt])
  // 영구 조치를 기다리는 장애를 찾는다 (TASK-3801)
  @@index([fixKind, resolvedAt])
  // 확인 대기 초안을 먼저 찾는다 (TASK-3901)
  @@index([status, startedAt])
  // 수명 질의는 만들어진 시각 순이다 (TASK-4001)
  @@index([status, createdAt])
  // 되살림 이력 (TASK-4101)
  @@index([revivedAt])
  @@map("incidents")
}

/**
 * 운영 이벤트 (TASK-3801, CTO 정책 3801-①).
 * 시스템이 관측한 **상태 변화**다. 활성화가 완료되는 순간은 대개 아무도
 * 화면을 보고 있지 않을 때 온다(방화벽이 열렸거나, 결제가 풀렸거나, CI가
 * 마침내 초록이 됐을 때). 그 순간을 아무도 모르면 운영은 **이미 켤 수 있게
 * 된 상태로 며칠을 더 논다.**
 * 감사 기록(`OpsAuditLog`)과 한 표에 섞지 않는다 — 이쪽은 "무엇이
 * 일어났나"이고 저쪽은 "누가 했나"다.
 */
model OpsEvent {
  id          String    @id @default(cuid())
  /// activation-completed | activation-lost
  kind        String
  /// 같은 전이를 두 번 알리지 않기 위한 키 (표가 막는다)
  key         String    @unique
  title       String
  message     String
  /// 급한 소식인가 — 풀린 것은 급하다
  urgent      Boolean   @default(false)
  environment String
  /// 알림 채널로 내보낸 시각 — 못 보냈으면 null (보냈다고 적지 않는다)
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
  @@map("ops_events")
}

/**
 * 운영 감사 기록 (TASK-3801, CTO 정책 3801-④).
 * 장애 조사에서 가장 자주 필요한 문장은 **"그 시각에 누가 무엇을
 * 눌렀는가"** 다. 그래서 **실패한 시도도 남긴다** — 성공만 남는 기록으로는
 * 그 문장에 답할 수 없다.
 * 각 서비스가 감사 기록을 부르게 하면 다음에 추가되는 엔드포인트에서
 * 누군가 그 한 줄을 빠뜨리고, **빠진 감사 기록은 실패하지 않는다.**
 * 그래서 가로채기로 경로 전체에 한 번에 건다.
 */
model OpsAuditLog {
  id         String   @id @default(cuid())
  /// smoke.run | incident.resolve | backup.run … (URL이 바뀌어도 유지되는 이름)
  action     String
  title      String
  method     String
  path       String
  target     String?
  actorId    String?
  actorEmail String?
  /// ok | failed
  outcome    String
  statusCode Int?
  durationMs Int?
  /// 본문 요약 — 값이 아니라 **이름**만 (자격 증명이 새면 안 된다)
  detail     String?
  requestId  String?
  traceId    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@map("ops_audit_log")
}

// ── KPI 스냅샷 (TASK-4001, Sprint 40) ──────────────────────────

/**
 * KPI 한 시점의 값 (CTO 정책 4001-②).
 * TASK-3801의 KPI는 **현재값만** 말한다. "MTTR 180분"은 그 자체로 아무
 * 행동도 만들지 않고, 사람이 알아야 하는 것은 "나아지는 중인가"인데 그건
 * 두 번 재야 안다.
 * 그때 쓰인 임계값을 함께 적는 이유: 임계값이 바뀐 구간에서는 **값은
 * 비교할 수 있어도 상태(정상/주의/나쁨)는 비교할 수 없다.** 그 사실을
 * 나중에 복원할 수 없으면 "watch → good"을 개선으로 잘못 읽는다.
 * `value`가 null인 이유: 표본이 없어 값을 낼 수 없었던 시점이 있고, 그것을
 * 0으로 적으면 "완벽한 날"로 보인다 (정책 3801-③에서 세운 원칙).
 */
model KpiSnapshot {
  id             String   @id @default(cuid())
  /// mttr | mttd | incidents-open | … (packages/core의 KPI_IDS)
  kpiId          String
  /// 그때 값 — 표본이 없었으면 null. **0으로 적지 않는다**
  value          Float?
  /// good | watch | bad | unknown
  status         String
  /// 그때 쓰인 임계값 — 바뀌었으면 상태는 비교할 수 없다
  thresholdGood  Float?
  thresholdWatch Float?
  takenAt        DateTime @default(now())

  @@index([kpiId, takenAt])
  @@index([takenAt])
  @@map("kpi_snapshots")
}

// ── 진단 이력 (TASK-4101, Sprint 41) ──────────────────────────

/**
 * 진단 실행 1건 (CTO 정책 4101-②).
 * TASK-4001의 진단은 부를 때마다 새로 냈다. 그래서 화면이 "실패 2건"이라고
 * 말해도 그것이 **오늘 새로 생긴 것**인지 **지난주부터 계속 그랬던 것**인지
 * 알 수 없었다. 그 둘은 완전히 다른 소식이다 — 새로 생긴 것은 어제 무언가를
 * 바꿨다는 뜻이고 지금 되돌릴 수 있다.
 * `tier`를 함께 적는 이유(정책 4101-③): 스테이징과 운영은 판정 기준이
 * 다르므로 **같은 단계끼리만 비교**해야 한다.
 * `checks`에 항목 전체를 남기는 이유: 개수만 남기면 "무엇이" 나빠졌는지
 * 비교할 수 없고, 그러면 이력이 있어도 쓸 수 없다.
 */
model DiagnosticRun {
  id      String   @id @default(cuid())
  /// startup | daily | manual
  stage   String
  /// development | staging | production
  tier    String
  ok      Int
  warn    Int
  fail    Int
  unknown Int
  /// [{ id, title, status }] — 무엇이 나빠졌는지 비교하려면 항목이 필요하다
  checks  Json
  detail  String
  ranAt   DateTime @default(now())

  @@index([tier, stage, ranAt])
  @@index([ranAt])
  @@map("diagnostic_runs")
}
