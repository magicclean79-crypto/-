generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 최상위 루트 엔티티 — 여러 상품과 Product Object 버전을 묶는 작업 단위 (TASK-0301)
model Project {
  id              String          @id @default(cuid())
  name            String
  description     String?
  products        Product[]
  productObjects  ProductObject[]
  contents        Content[]
  sopRuns         SopRun[]
  decisions       Decision[]
  projectMemories ProjectMemory[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("projects")
}

model Product {
  id              String           @id @default(cuid())
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  name            String
  description     String?
  images          Image[]
  analysisResults AnalysisResult[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([projectId])
  @@map("products")
}

// Product Object — OCR/Vision 결과를 조립한 정규화 데이터 모델. Project별 버전 관리.
model ProductObject {
  id            String              @id @default(cuid())
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  version       Int
  status        ProductObjectStatus @default(DRAFT)
  title         String
  brand         String?
  category      String?
  attributes    Json?
  ocrSummary    Json?
  visionSummary Json?
  metadata      Json?
  contents      Content[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([projectId, version])
  @@index([projectId])
  @@index([status])
  @@map("product_objects")
}

enum ProductObjectStatus {
  DRAFT
  READY
  ARCHIVED
}

model AnalysisResult {
  id          String         @id @default(cuid())
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  provider    String
  status      AnalysisStatus @default(PENDING)
  result      Json? // 구조화된 ProductAnalysis
  rawJson     Json? // Provider 원본 응답
  error       String?
  attempts    Int            @default(0)
  applied     Boolean        @default(false)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([productId])
  @@index([status])
  @@map("analysis_results")
}

enum AnalysisStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model Image {
  id           String      @id @default(cuid())
  key          String      @unique
  url          String
  originalName String
  mimeType     String
  size         Int
  product      Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId    String?
  ocrResults   OcrResult[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([productId])
  @@map("images")
}

model OcrResult {
  id            String    @id @default(cuid())
  image         Image     @relation(fields: [imageId], references: [id], onDelete: Cascade)
  imageId       String
  provider      String
  status        OcrStatus @default(PENDING)
  confidence    Float? // 0.0 ~ 1.0
  extractedText String?
  rawJson       Json? // Provider 원본 응답
  error         String?
  attempts      Int       @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([imageId])
  @@index([status])
  @@map("ocr_results")
}

enum OcrStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

// 상세페이지 콘텐츠 — Product Object를 단일 입력으로 생성된다 (TASK-0303)
model Content {
  id              String                 @id @default(cuid())
  project         Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  productObject   ProductObject?         @relation(fields: [productObjectId], references: [id], onDelete: SetNull)
  productObjectId String?
  title           String
  body            String
  status          ContentStatus          @default(DRAFT)
  publishedAt     DateTime? // 발행 시각 (TASK-0703) — PUBLISHED 전이 시 기록
  statusHistory   ContentStatusHistory[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([projectId])
  @@map("contents")
}

// 발행 파이프라인 감사 이력 (TASK-0704) — 상태 전이 1건당 1레코드
model ContentStatusHistory {
  id         String        @id @default(cuid())
  content    Content       @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId  String
  fromStatus ContentStatus
  toStatus   ContentStatus
  actor      String? // 수행자 이메일 (TASK-0801 Actor Audit) — 인증 도입 전 기록은 null
  createdAt  DateTime      @default(now())

  @@index([contentId, createdAt])
  @@map("content_status_history")
}

// ── 인증/권한 Foundation (TASK-0801, Sprint 8) ─────────

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  name             String
  passwordHash     String
  role             UserRole      @default(VIEWER)
  disabled         Boolean       @default(false) // 비활성화 시 로그인/세션 무효 (TASK-0802)
  failedLoginCount Int           @default(0) // 연속 로그인 실패 횟수 (TASK-0804 잠금)
  lockedUntil      DateTime? // 이 시각까지 로그인 잠금 (TASK-0804, null=잠금 없음)
  sessions         AuthSession[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("users")
}

// 사용자 관리 감사 로그 (TASK-0802) — 생성/역할 변경/비활성화 1건당 1레코드
model UserAuditLog {
  id          String   @id @default(cuid())
  actor       String // 수행자 이메일
  action      String // USER_CREATED | ROLE_CHANGED | USER_DISABLED | USER_ENABLED
  targetEmail String
  detail      String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("user_audit_log")
}

// DB 저장형 세션 — 토큰 1개당 1레코드, 만료 시각으로 무효화
model AuthSession {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("auth_sessions")
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

// SOP 실행 이력 — 표준 절차 1회 실행의 단계별 결과 (TASK-0305)
model SopRun {
  id          String       @id @default(cuid())
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  sopKey      String
  status      SopRunStatus @default(RUNNING)
  steps       Json // 단계별 결과 (SopStepResultDto[])
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([projectId])
  @@map("sop_runs")
}

enum SopRunStatus {
  RUNNING
  DONE
  FAILED
}

// 의사결정 로그 — 프로젝트별 결정 기록 (TASK-0306)
model Decision {
  id           String       @id @default(cuid())
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String
  title        String
  description  String?
  reason       String
  decisionType DecisionType
  author       String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([projectId])
  @@map("decisions")
}

// 프로젝트 메모형 기억 — 구 Memory(TASK-0307)를 TASK-0402에서 개칭·보존
model ProjectMemory {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  title     String
  content   String
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("project_memories")
}

// 표준 Structured Memory — Company Brain의 구조화 저장소 (TASK-0402)
model Memory {
  id          String      @id @default(cuid())
  scope       MemoryScope
  scopeId     String?
  key         String
  value       Json
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([scope, scopeId, key])
  @@index([scope, scopeId])
  @@map("memories")
}

// Memory 적용 범위 — CTO 결정으로 Enum 고정 (TASK-0402 승인 리뷰)
enum MemoryScope {
  GLOBAL
  COMPANY
  PROJECT
  PRODUCT
}

// 회사 공식 지식 — Company Brain 전역 (프로젝트 무관, TASK-0401)
model Knowledge {
  id        String             @id @default(cuid())
  title     String
  content   String
  category  KnowledgeCategory?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([category])
  @@map("knowledge")
}

// 지식 분류 — CTO 결정으로 Enum 고정 (TASK-0401 승인 리뷰)
enum KnowledgeCategory {
  RULE
  POLICY
  GUIDE
  BRAND
  LEGAL
  QUALITY
  FAQ
  OTHER
}

// 결정 유형 — CTO 결정으로 Enum 고정 (TASK-0306 승인 리뷰)
enum DecisionType {
  ARCHITECTURE
  PROCESS
  PRODUCT
  BUSINESS
  TECHNICAL
  QUALITY
  SECURITY
  OTHER
}

// ── Execution Domain (TASK-0601, Sprint 6) ─────────────
// 모든 LLM 호출(Content/Analysis/Vision/개발용) 1건당 1레코드 — 관측 전용
enum ExecutionStatus {
  SUCCESS
  FAILED
}

model Execution {
  id           String          @id @default(cuid())
  feature      String // content-generation | product-analysis | vision-analysis | dev
  provider     String
  model        String
  status       ExecutionStatus
  inputTokens  Int?
  outputTokens Int?
  cost         Decimal?        @db.Decimal(12, 6) // 예상 비용(USD) — 가격표 없는 모델은 null
  latencyMs    Int
  error        String?
  createdAt    DateTime        @default(now())

  @@index([feature, createdAt])
  @@map("executions")
}

// ── Experiment Lifecycle & Sticky Assignment (TASK-1101, Sprint 11) ──

enum ExperimentStatus {
  RUNNING // 배정 진행 — 실험 정의(환경변수)가 있으면 기본 상태
  STOPPED // 중단 — 배정하지 않고 기존 라우팅으로 처리
  PROMOTED // 승자 확정 — 전 트래픽을 승자 변형으로 보낸다
}

// feature별 실험의 운영 상태. 정의(변형·가중치)는 환경변수가 원천이고
// (CTO 결정 1003-②로 표기법 확정), 이 표는 **운영 중 바뀌는 상태**만 갖는다.
// 행이 없으면 RUNNING으로 본다 (TASK-1003 동작 보존).
model ExperimentState {
  id              String           @id @default(cuid())
  feature         String           @unique
  status          ExperimentStatus @default(RUNNING)
  // 승자 변형 키 (`provider` 또는 `provider:model`) — PROMOTED일 때만 유효
  promotedVariant String?
  actor           String? // 마지막 조작자 (이메일)
  note            String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  events      ExperimentEvent[]
  assignments ExperimentAssignment[]

  @@map("experiment_states")
}

// 상태 전이 이력 — Rollback은 이 이력의 직전 상태로 되돌린다 (감사 겸용)
model ExperimentEvent {
  id              String           @id @default(cuid())
  stateId         String
  state           ExperimentState  @relation(fields: [stateId], references: [id], onDelete: Cascade)
  action          String // START | STOP | PROMOTE | ROLLBACK
  fromStatus      ExperimentStatus
  toStatus        ExperimentStatus
  fromVariant     String?
  toVariant       String?
  actor           String?
  note            String?
  createdAt       DateTime         @default(now())

  @@index([stateId, createdAt])
  @@map("experiment_events")
}

// Project 기반 Sticky Assignment — 같은 프로젝트는 항상 같은 변형을 받는다.
// 배정은 결정적 해시로 정해지므로 이 표가 없어도 결과는 같고, 표는
// **관측·감사(Assignment Dashboard)** 를 위해 남긴다.
model ExperimentAssignment {
  id         String          @id @default(cuid())
  stateId    String
  state      ExperimentState @relation(fields: [stateId], references: [id], onDelete: Cascade)
  feature    String
  projectId  String
  variantKey String
  // 배정이 만들어진 시점의 실험 정의 서명 — 정의가 바뀌면 재배정한다
  signature  String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([feature, projectId])
  @@index([feature, variantKey])
  @@map("experiment_assignments")
}
