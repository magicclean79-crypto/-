generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id              String           @id @default(cuid())
  name            String
  description     String?
  contents        Content[]
  images          Image[]
  analysisResults AnalysisResult[]
  productObjects  ProductObject[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("products")
}

// Product Object — OCR/Vision 결과를 조립한 정규화 데이터 모델.
// 현재 구조에서 "프로젝트" 단위는 Product(업로드 그룹)이며 projectId가 이를 참조한다.
model ProductObject {
  id            String              @id @default(cuid())
  project       Product             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  version       Int
  status        ProductObjectStatus @default(DRAFT)
  title         String
  brand         String?
  category      String?
  attributes    Json?
  ocrSummary    Json?
  visionSummary Json?
  metadata      Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([projectId, version])
  @@index([projectId])
  @@index([status])
  @@map("product_objects")
}

enum ProductObjectStatus {
  DRAFT
  READY
  ARCHIVED
}

model AnalysisResult {
  id          String         @id @default(cuid())
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  provider    String
  status      AnalysisStatus @default(PENDING)
  result      Json? // 구조화된 ProductAnalysis
  rawJson     Json? // Provider 원본 응답
  error       String?
  attempts    Int            @default(0)
  applied     Boolean        @default(false)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([productId])
  @@index([status])
  @@map("analysis_results")
}

enum AnalysisStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model Image {
  id           String      @id @default(cuid())
  key          String      @unique
  url          String
  originalName String
  mimeType     String
  size         Int
  product      Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId    String?
  ocrResults   OcrResult[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([productId])
  @@map("images")
}

model OcrResult {
  id            String    @id @default(cuid())
  image         Image     @relation(fields: [imageId], references: [id], onDelete: Cascade)
  imageId       String
  provider      String
  status        OcrStatus @default(PENDING)
  confidence    Float? // 0.0 ~ 1.0
  extractedText String?
  rawJson       Json? // Provider 원본 응답
  error         String?
  attempts      Int       @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([imageId])
  @@index([status])
  @@map("ocr_results")
}

enum OcrStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model Content {
  id        String        @id @default(cuid())
  title     String
  body      String
  status    ContentStatus @default(DRAFT)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([productId])
  @@map("contents")
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}
