generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 최상위 루트 엔티티 — 여러 상품과 Product Object 버전을 묶는 작업 단위 (TASK-0301)
model Project {
  id              String          @id @default(cuid())
  name            String
  description     String?
  products        Product[]
  productObjects  ProductObject[]
  contents        Content[]
  sopRuns         SopRun[]
  decisions       Decision[]
  projectMemories ProjectMemory[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("projects")
}

model Product {
  id              String           @id @default(cuid())
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  name            String
  description     String?
  images          Image[]
  analysisResults AnalysisResult[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([projectId])
  @@map("products")
}

// Product Object — OCR/Vision 결과를 조립한 정규화 데이터 모델. Project별 버전 관리.
model ProductObject {
  id            String              @id @default(cuid())
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  version       Int
  status        ProductObjectStatus @default(DRAFT)
  title         String
  brand         String?
  category      String?
  attributes    Json?
  ocrSummary    Json?
  visionSummary Json?
  metadata      Json?
  contents      Content[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([projectId, version])
  @@index([projectId])
  @@index([status])
  @@map("product_objects")
}

enum ProductObjectStatus {
  DRAFT
  READY
  ARCHIVED
}

model AnalysisResult {
  id          String         @id @default(cuid())
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  provider    String
  status      AnalysisStatus @default(PENDING)
  result      Json? // 구조화된 ProductAnalysis
  rawJson     Json? // Provider 원본 응답
  error       String?
  attempts    Int            @default(0)
  applied     Boolean        @default(false)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([productId])
  @@index([status])
  @@map("analysis_results")
}

enum AnalysisStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model Image {
  id           String      @id @default(cuid())
  key          String      @unique
  url          String
  originalName String
  mimeType     String
  size         Int
  product      Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId    String?
  ocrResults   OcrResult[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([productId])
  @@map("images")
}

model OcrResult {
  id            String    @id @default(cuid())
  image         Image     @relation(fields: [imageId], references: [id], onDelete: Cascade)
  imageId       String
  provider      String
  status        OcrStatus @default(PENDING)
  confidence    Float? // 0.0 ~ 1.0
  extractedText String?
  rawJson       Json? // Provider 원본 응답
  error         String?
  attempts      Int       @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([imageId])
  @@index([status])
  @@map("ocr_results")
}

enum OcrStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

// 상세페이지 콘텐츠 — Product Object를 단일 입력으로 생성된다 (TASK-0303)
model Content {
  id              String         @id @default(cuid())
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  productObject   ProductObject? @relation(fields: [productObjectId], references: [id], onDelete: SetNull)
  productObjectId String?
  title           String
  body            String
  status          ContentStatus  @default(DRAFT)
  publishedAt     DateTime? // 발행 시각 (TASK-0703) — PUBLISHED 전이 시 기록
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([projectId])
  @@map("contents")
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

// SOP 실행 이력 — 표준 절차 1회 실행의 단계별 결과 (TASK-0305)
model SopRun {
  id          String       @id @default(cuid())
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  sopKey      String
  status      SopRunStatus @default(RUNNING)
  steps       Json // 단계별 결과 (SopStepResultDto[])
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([projectId])
  @@map("sop_runs")
}

enum SopRunStatus {
  RUNNING
  DONE
  FAILED
}

// 의사결정 로그 — 프로젝트별 결정 기록 (TASK-0306)
model Decision {
  id           String       @id @default(cuid())
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String
  title        String
  description  String?
  reason       String
  decisionType DecisionType
  author       String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([projectId])
  @@map("decisions")
}

// 프로젝트 메모형 기억 — 구 Memory(TASK-0307)를 TASK-0402에서 개칭·보존
model ProjectMemory {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  title     String
  content   String
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("project_memories")
}

// 표준 Structured Memory — Company Brain의 구조화 저장소 (TASK-0402)
model Memory {
  id          String      @id @default(cuid())
  scope       MemoryScope
  scopeId     String?
  key         String
  value       Json
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([scope, scopeId, key])
  @@index([scope, scopeId])
  @@map("memories")
}

// Memory 적용 범위 — CTO 결정으로 Enum 고정 (TASK-0402 승인 리뷰)
enum MemoryScope {
  GLOBAL
  COMPANY
  PROJECT
  PRODUCT
}

// 회사 공식 지식 — Company Brain 전역 (프로젝트 무관, TASK-0401)
model Knowledge {
  id        String             @id @default(cuid())
  title     String
  content   String
  category  KnowledgeCategory?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([category])
  @@map("knowledge")
}

// 지식 분류 — CTO 결정으로 Enum 고정 (TASK-0401 승인 리뷰)
enum KnowledgeCategory {
  RULE
  POLICY
  GUIDE
  BRAND
  LEGAL
  QUALITY
  FAQ
  OTHER
}

// 결정 유형 — CTO 결정으로 Enum 고정 (TASK-0306 승인 리뷰)
enum DecisionType {
  ARCHITECTURE
  PROCESS
  PRODUCT
  BUSINESS
  TECHNICAL
  QUALITY
  SECURITY
  OTHER
}

// ── Execution Domain (TASK-0601, Sprint 6) ─────────────
// 모든 LLM 호출(Content/Analysis/Vision/개발용) 1건당 1레코드 — 관측 전용
enum ExecutionStatus {
  SUCCESS
  FAILED
}

model Execution {
  id           String          @id @default(cuid())
  feature      String // content-generation | product-analysis | vision-analysis | dev
  provider     String
  model        String
  status       ExecutionStatus
  inputTokens  Int?
  outputTokens Int?
  cost         Decimal?        @db.Decimal(12, 6) // 예상 비용(USD) — 가격표 없는 모델은 null
  latencyMs    Int
  error        String?
  createdAt    DateTime        @default(now())

  @@index([feature, createdAt])
  @@map("executions")
}
