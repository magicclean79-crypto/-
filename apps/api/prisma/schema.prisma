generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id              String           @id @default(cuid())
  name            String
  description     String?
  contents        Content[]
  images          Image[]
  analysisResults AnalysisResult[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("products")
}

model AnalysisResult {
  id          String         @id @default(cuid())
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  provider    String
  status      AnalysisStatus @default(PENDING)
  result      Json? // 구조화된 ProductAnalysis
  rawJson     Json? // Provider 원본 응답
  error       String?
  attempts    Int            @default(0)
  applied     Boolean        @default(false)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([productId])
  @@index([status])
  @@map("analysis_results")
}

enum AnalysisStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model Image {
  id           String      @id @default(cuid())
  key          String      @unique
  url          String
  originalName String
  mimeType     String
  size         Int
  product      Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId    String?
  ocrResults   OcrResult[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([productId])
  @@map("images")
}

model OcrResult {
  id            String    @id @default(cuid())
  image         Image     @relation(fields: [imageId], references: [id], onDelete: Cascade)
  imageId       String
  provider      String
  status        OcrStatus @default(PENDING)
  confidence    Float? // 0.0 ~ 1.0
  extractedText String?
  rawJson       Json? // Provider 원본 응답
  error         String?
  attempts      Int       @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([imageId])
  @@index([status])
  @@map("ocr_results")
}

enum OcrStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model Content {
  id        String        @id @default(cuid())
  title     String
  body      String
  status    ContentStatus @default(DRAFT)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([productId])
  @@map("contents")
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}
